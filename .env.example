# Backend-only secrets. Restart the backend after changing this file.
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev

# Any provider implementing POST /chat/completions.
# Include the API prefix, e.g. https://api.openai.com/v1 or http://localhost:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Set false for compatible providers that don't support response_format.
OPENAI_JSON_MODE=true

CRAWL_PAGE_LIMIT=20
LINK_CHECK_LIMIT=300
LINK_CONCURRENCY=5
REQUEST_TIMEOUT_SECONDS=12
AUDIT_TIMEOUT_SECONDS=180
AI_TIMEOUT_SECONDS=40
MAX_CONCURRENT_AUDITS=2
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional SQLite path; defaults to data/crawlens.sqlite3 in the project.
# DATABASE_PATH=C:/path/to/crawlens.sqlite3

# Deterministic scoring. Weights are integer percentages and sum to 100.
METRIC_WEIGHTS={"metadata":12,"broken_links":12,"indexability":16,"performance":13,"headings":8,"site_health":7,"canonical":10,"structured_data":10,"media":7,"geo":5}
TITLE_MIN=30
TITLE_MAX=60
DESCRIPTION_MIN=70
DESCRIPTION_MAX=160
LCP_MS=2500
INP_MS=200
CLS_LIMIT=0.1
EXCELLENT_SCORE=90
GOOD_SCORE=75
IMPROVEMENT_SCORE=50
THIN_WORD_LIMIT=50
SIMILARITY_THRESHOLD=0.9
LARGE_RESOURCE_BYTES=250000

# Mobile PageSpeed sample per audit. Zero disables this measurement.
PAGESPEED_PAGE_LIMIT=1
# Google Cloud Console > APIs & Services > enable "PageSpeed Insights API" > Credentials > API key.
# Without a key Google allows very few requests (HTTP 429), and the score is then calculated without speed.
PAGESPEED_API_KEY=
SITEMAP_FILE_LIMIT=40
SITEMAP_BYTES=5000000
MEDIA_CHECK_LIMIT=80
# Add approved media CDN or sitemap-hosting hostnames when needed.
MEDIA_HOSTS=[]
SITEMAP_HOSTS=[]
SEARCH_CRAWLERS=["Googlebot","Bingbot"]
AI_CRAWLERS=["Googlebot","OAI-SearchBot","PerplexityBot"]
# Utility pages: not crawled, and marked N/A for indexability. Matched as whole path segments.
EXCLUDED_PATH_SEGMENTS=["cart","basket","checkout","account","my-account","login","logout","signin","sign-in","register","wishlist","search"]
REQUIRED_INDEX_URLS=[]
