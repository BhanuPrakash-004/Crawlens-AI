{
  "name": "crawlens-ai",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm run dev --workspace frontend",
    "dev:api": "node scripts/backend.mjs dev",
    "build": "npm run build --workspace frontend",
    "start": "node scripts/backend.mjs start",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "node scripts/backend.mjs test",
    "test:frontend": "npm run test --workspace frontend",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
